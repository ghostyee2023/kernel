# ============================================================
# Kernel · 创意种子 — P0 本地桩环境变量样例
# 复制为 .env（或 .env.local 覆盖）后即可运行
# 标记 ⬆️ 的条目为「生产化替换点」
# ============================================================

# ---- 数据库 ----
# ⬆️ Vercel 试验部署（Turso）：libsql://{db-name}-{org}.turso.io，并配 TURSO_AUTH_TOKEN
#     以 libsql: 开头 = 云模式（driver adapter 走 HTTP）；本地保持 file: 原生引擎
# ⬆️ 生产（正式）：postgresql://user:pass@host:5432/kernel
DATABASE_URL="file:./dev.db"

# ---- Turso 认证（Vercel 试验部署 · 数据层云模式开关）----
# 生成：turso db tokens create {db-name}
# TURSO_AUTH_TOKEN="eyJ..."

# ---- 本地对象存储 ----
# ⬆️ Vercel 试验部署：KERNEL_DATA_DIR="/tmp/kernel-data"（单请求临时盘，冷启动重置；
#     持久文件走 Blob，见下）。本地保持 ./.kernel-data
# ⬆️ 生产：/data 挂载卷，或替换 src/lib/storage.ts 为 S3 实现
KERNEL_DATA_DIR="./.kernel-data"

# ---- Vercel Blob（Vercel 试验部署 · 存储层云模式开关）----
# 判定：NODE_ENV=production 且（BLOB_READ_WRITE_TOKEN 或 BLOB_TOKEN）存在 → 走 Blob REST；
#     否则本地磁盘。Vercel 平台会为 Blob Store 自动注入 BLOB_READ_WRITE_TOKEN。
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# BLOB_TOKEN="vercel_blob_rw_..."          # 兼容别名（手动配置时使用）
# BLOB_STORE_ID="..."                      # 拼公共读 URL 用；缺省从 token 解析

# ---- 站点与沙箱 ----
SITE_URL="http://localhost:3000"
# subpath（本地）| subdomain（生产）⬆️
SANDBOX_MODE="subpath"
SANDBOX_BASE_PATH="/sandbox"
# ⬆️ 仅 subdomain 模式生效，必须是与主站不同的注册域
SANDBOX_DOMAIN="demo-sandbox.com"
# 是否下发 CSP sandbox 指令（不透明源）。关闭后作品可用 localStorage，但本地隔离降级
SANDBOX_CSP_STRICT="true"

# ---- 作品生命周期 ----
DEFAULT_TTL_DAYS="90"
RECYCLE_BIN_DAYS="30"

# ---- 上传限额 ----
# ⬆️ Vercel 试验部署：生产建议 MAX_UPLOAD_MB="20"（Hobby 300s 窗口内下载+解压+重传风险）；
#     分片大小生产自动 3MB（Vercel Function 请求体 4.5MB 上限），本地仍 5MB
MAX_UPLOAD_MB="100"
MAX_EXTRACTED_MB="200"
MAX_ZIP_ENTRIES="2000"
MAX_ZIP_RATIO="100"
MAX_ZIP_ENTRY_MB="50"

# ---- 运维 ----
# POST /api/admin/cleanup/run 的 X-Admin-Token；NODE_ENV=production 时该端点恒 403
ADMIN_CLEANUP_TOKEN="dev-only-token"

# ---- Vercel Cron 调度（Vercel 试验部署 · 调度层）----
# /api/cron/run 鉴权：Authorization: Bearer {CRON_SECRET} / X-Cron-Secret / ?secret= 任一。
# 本地默认值；生产 Vercel 平台配随机强值。每日 03:10 UTC 由 vercel.json crons 触发。
CRON_SECRET="dev-cron-secret"

# ============================================================
# P1 启用（占位，P1+ 启用）⬆️
# 用户名密码（展示用）会话签名密钥；生产必须显式设置随机值，缺失时 auth.ts 用 dev fallback
AUTH_SECRET="kernel-dev-auth-secret-change-me"
# P0 不需要（占位，P1+ 启用）⬆️
# REDIS_URL=
# S3_ENDPOINT=  S3_BUCKET=  S3_ACCESS_KEY=  S3_SECRET_KEY=
# WECHAT_APPID=  WECHAT_SECRET=
# ============================================================
